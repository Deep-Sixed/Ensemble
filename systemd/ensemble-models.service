# Copy to /etc/systemd/system/ensemble-models.service
# Then: sudo systemctl daemon-reload && sudo systemctl enable --now ensemble-models.service
# Model services are Compose profiles; without COMPOSE_PROFILES this starts only
# the router. Add e.g. Environment=COMPOSE_PROFILES=qwen25-coder via systemctl edit.

[Unit]
Description=Ensemble local LLM model stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/jarvis/projects/third-party/ensemble
ExecStart=/usr/bin/docker compose -f docker-compose.models.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.models.yml down
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
