{
  "name": "ensemble",
  "displayName": "Ensemble",
  "description": "Build Ensemble code-context packets for a task and hand them to any agent.",
  "version": "0.2.0",
  "publisher": "ensemble",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "fix": "biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "configuration": {
      "title": "Ensemble",
      "properties": {
        "ensemble.cliPath": {
          "type": "string",
          "default": "ensemble",
          "description": "Path to the `ensemble` CLI."
        },
        "ensemble.tokenBudget": {
          "type": "number",
          "default": 12000,
          "minimum": 1,
          "description": "Maximum estimated tokens in the context packet."
        },
        "ensemble.semantic": {
          "type": "boolean",
          "default": true,
          "description": "Enrich context with LSP symbols, definitions and references (slower; requires language servers)."
        }
      }
    },
    "commands": [
      {
        "command": "ensemble.buildContext",
        "title": "Ensemble: Build Context for Task"
      }
    ]
  }
}
