# Ensemble host settings
# The LLM, API key, token, and temperature values below win over
# ENSEMBLE_PROFILE, which only fills settings left unset. To target a profile's
# endpoint, pass --profile NAME to health, models, ask, or chat.
ENSEMBLE_LLM_BASE_URL=http://localhost:8888/v1
ENSEMBLE_LLM_MODEL=qwen3-4b-instruct-2507-ud-q4_k_xl
ENSEMBLE_API_KEY=ensemble
ENSEMBLE_PROFILE=auto
ENSEMBLE_MAX_TOKENS=1024
ENSEMBLE_TEMPERATURE=0.2

# Workspace for agent context. Keep this outside Ensemble itself.
ENSEMBLE_WORKSPACE=/home/jarvis/projects/nexus
# Not read yet; docker-compose.yml mounts the workspace at /workspace.
ENSEMBLE_DOCKER_WORKSPACE=/workspace

# Safety defaults for v1.
ENSEMBLE_ALLOW_WRITES=false
ENSEMBLE_ALLOW_SHELL=false
ENSEMBLE_MAX_FILE_BYTES=200000
# The two dirs below are not read yet; checkpoints always go to state/checkpoints.
ENSEMBLE_CHECKPOINT_DIR=state/checkpoints
ENSEMBLE_EVIDENCE_DIR=state/evidence

# Docker llama.cpp service settings.
ENSEMBLE_ROOT=/home/jarvis/projects/third-party/ensemble
ENSEMBLE_HOST_MODEL_DIR=/home/jarvis/projects/third-party/ensemble/models
ENSEMBLE_MODEL_PATH=/models/qwen3-4b-instruct-2507-ud-q4_k_xl.gguf
ENSEMBLE_MODEL_ALIAS=qwen3-4b-instruct-2507-ud-q4_k_xl
ENSEMBLE_SERVER_HOST=0.0.0.0
ENSEMBLE_SERVER_PORT=8888
ENSEMBLE_N_CTX=32768
ENSEMBLE_N_THREADS=6
